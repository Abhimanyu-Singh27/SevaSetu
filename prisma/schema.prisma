generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  WORKER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
  DEACTIVATED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum VerificationStatus {
  NOT_VERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum PricingType {
  FIXED
  PER_HOUR
  PER_DAY
  STARTING_FROM
  QUOTE_REQUIRED
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  SENT
  ACCEPTED
  REJECTED
  SCHEDULED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum LedgerEntryType {
  EARNING
  PLATFORM_FEE
  REFUND
  PAYOUT
}

enum FraudSignalStatus {
  OPEN
  REVIEWED
  DISMISSED
  CONFIRMED
}

model FinancialEntry {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  requestId   String?         @db.Uuid
  type        LedgerEntryType
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("INR")
  reference   String?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  request     ServiceRequest? @relation(fields: [requestId], references: [id])
  @@index([userId, type, createdAt])
  @@index([requestId, type])
}

model CompletionProof {
  id          String         @id @default(uuid()) @db.Uuid
  requestId   String         @db.Uuid
  submittedBy String         @db.Uuid
  note        String?
  objectKey   String?
  createdAt   DateTime       @default(now())
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@index([requestId, createdAt])
}

model DisputeCase {
  id          String         @id @default(uuid()) @db.Uuid
  requestId   String         @unique @db.Uuid
  openedBy    String         @db.Uuid
  status      ReportStatus   @default(SUBMITTED)
  resolution  String?
  resolvedBy  String?        @db.Uuid
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
}

model LocationEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  requestId   String?  @db.Uuid
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  consented   Boolean  @default(false)
  retentionUntil DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([requestId, createdAt])
}

model FraudSignal {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String?           @db.Uuid
  fingerprint String
  reason      String
  score       Int               @default(0)
  status      FraudSignalStatus @default(OPEN)
  metadata    Json?
  createdAt   DateTime          @default(now())
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([status, score, createdAt])
  @@index([fingerprint])
}

model Broadcast {
  id          String   @id @default(uuid()) @db.Uuid
  createdBy   String   @db.Uuid
  title       String
  body        String
  audienceRole UserRole?
  createdAt   DateTime @default(now())
  createdByUser User    @relation(fields: [createdBy], references: [id])
  @@index([createdAt])
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  INVESTIGATING
  RESOLVED
  REJECTED
}

enum NotificationType {
  REQUEST_UPDATE
  MESSAGE
  REVIEW
  REPORT_UPDATE
  SECURITY
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique
  displayName     String?
  phone           String?      @unique
  passwordHash    String
  role            UserRole
  status          UserStatus   @default(ACTIVE)
  emailVerifiedAt DateTime?
  preferredLanguage String       @default("en")
  mfaEnabled     Boolean      @default(false)
  mfaSecret      String?
  lastActiveAt    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  customerProfile CustomerProfile?
  workerProfile   WorkerProfile?
  sessions        Session[]
  sentMessages    Message[]
  notifications   Notification[]
  submittedReports Report[]    @relation("Reporter")
  receivedReports  Report[]    @relation("ReportedUser")
  reviews         Review[]
  auditEvents     AuditLog[]
  savedWorkers    SavedWorker[]
  addresses       Address[]
  conversationMemberships ConversationMember[]
  authTokens       AuthToken[]
  idempotencyKeys  IdempotencyKey[]
  realtimeEvents   RealtimeEvent[]
  financialEntries FinancialEntry[]
  locationEvents  LocationEvent[]
  fraudSignals    FraudSignal[]
  broadcasts      Broadcast[]

  @@index([role, status])
  @@index([lastActiveAt])
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type, expiresAt])
}

model IdempotencyKey {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  route          String
  key            String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, route, key])
  @@index([expiresAt])
}

model RealtimeEvent {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  actorId        String    @db.Uuid
  audienceUserIds Json
  payload        Json
  createdAt      DateTime  @default(now())
  actor          User      @relation(fields: [actorId], references: [id], onDelete: Cascade)
  @@index([createdAt])
  @@index([actorId, createdAt])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  refreshHash  String   @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model CustomerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  fullName  String
  avatarUrl String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests  ServiceRequest[]
}

model WorkerProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @db.Uuid
  fullName           String
  bio                String?
  avatarUrl          String?
  experienceYears    Int                @default(0)
  availability       AvailabilityStatus @default(OFFLINE)
  verificationStatus VerificationStatus @default(NOT_VERIFIED)
  serviceRadiusKm    Decimal?           @db.Decimal(7, 2)
  latitude           Decimal?           @db.Decimal(9, 6)
  longitude          Decimal?           @db.Decimal(9, 6)
  responseRate       Decimal            @default(0) @db.Decimal(5, 2)
  completionRate     Decimal            @default(0) @db.Decimal(5, 2)
  cancellationRate   Decimal            @default(0) @db.Decimal(5, 2)
  ratingAverage      Decimal            @default(0) @db.Decimal(3, 2)
  ratingCount        Int                @default(0)
  completedJobs      Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services           WorkerService[]
  requests           ServiceRequest[]   @relation("AssignedWorker")
  availabilitySessions WorkerAvailabilitySession[]
  reviews            Review[]
  verification      Verification?
  savedBy            SavedWorker[]
  @@index([availability, verificationStatus])
  @@index([latitude, longitude])
  @@index([ratingAverage, completedJobs])
}

model WorkerAvailabilitySession {
  id        String        @id @default(uuid()) @db.Uuid
  workerId  String        @db.Uuid
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, startedAt])
  @@index([workerId, endedAt])
}

model ServiceCategory {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @unique
  slug        String            @unique
  description String?
  active      Boolean           @default(true)
  services    Service[]
  createdAt   DateTime          @default(now())
}

model Service {
  id          String          @id @default(uuid()) @db.Uuid
  categoryId  String          @db.Uuid
  name        String
  slug        String          @unique
  description String?
  active      Boolean         @default(true)
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  workers     WorkerService[]
  requests    ServiceRequest[]
  @@index([categoryId, active])
}

model WorkerService {
  id          String      @id @default(uuid()) @db.Uuid
  workerId    String      @db.Uuid
  serviceId   String      @db.Uuid
  pricingType PricingType
  price       Decimal?    @db.Decimal(12, 2)
  description String?
  worker      WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  service     Service       @relation(fields: [serviceId], references: [id])
  @@unique([workerId, serviceId])
  @@index([serviceId, pricingType])
}

model ServiceRequest {
  id              String        @id @default(uuid()) @db.Uuid
  customerId      String        @db.Uuid
  workerId        String?       @db.Uuid
  serviceId       String        @db.Uuid
  status          RequestStatus @default(DRAFT)
  description     String
  preferredDate   DateTime?
  preferredTime   String?
  budget          Decimal?      @db.Decimal(12, 2)
  locationLabel   String?
  latitude        Decimal?      @db.Decimal(9, 6)
  longitude       Decimal?      @db.Decimal(9, 6)
  locationConsent Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        CustomerProfile @relation(fields: [customerId], references: [id])
  worker          WorkerProfile? @relation("AssignedWorker", fields: [workerId], references: [id])
  service         Service        @relation(fields: [serviceId], references: [id])
  history         RequestStatusHistory[]
  reviews         Review[]
  reports         Report[]
  attachments     FileAsset[]
  conversation     Conversation?
  completionProofs CompletionProof[]
  financialEntries FinancialEntry[]
  dispute          DisputeCase?
  completedAt      DateTime?
  completionApprovedAt DateTime?
  @@index([customerId, status, createdAt])
  @@index([workerId, status, createdAt])
}

model RequestStatusHistory {
  id        String        @id @default(uuid()) @db.Uuid
  requestId String        @db.Uuid
  status    RequestStatus
  actorId   String        @db.Uuid
  note      String?
  createdAt DateTime      @default(now())
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@index([requestId, createdAt])
}

model Conversation {
  id        String              @id @default(uuid()) @db.Uuid
  requestId String?             @unique @db.Uuid
  createdAt DateTime            @default(now())
  request   ServiceRequest?     @relation(fields: [requestId], references: [id])
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  senderId       String       @db.Uuid
  type           MessageType  @default(TEXT)
  body           String?
  mediaUrl       String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
  @@index([conversationId, createdAt])
}

model Review {
  id            String        @id @default(uuid()) @db.Uuid
  requestId     String        @db.Uuid
  workerId      String        @db.Uuid
  customerId    String        @db.Uuid
  rating        Int
  quality       Int?
  behaviour     Int?
  punctuality   Int?
  communication Int?
  value         Int?
  body          String?
  createdAt     DateTime      @default(now())
  request       ServiceRequest @relation(fields: [requestId], references: [id])
  worker        WorkerProfile  @relation(fields: [workerId], references: [id])
  customer      User            @relation(fields: [customerId], references: [id])
  @@unique([requestId, customerId])
  @@index([workerId, createdAt])
}

model Report {
  id           String       @id @default(uuid()) @db.Uuid
  reporterId   String       @db.Uuid
  reportedUserId String     @db.Uuid
  requestId    String?      @db.Uuid
  category     String
  description  String
  status       ReportStatus @default(SUBMITTED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id])
  reportedUser User         @relation("ReportedUser", fields: [reportedUserId], references: [id])
  request      ServiceRequest? @relation(fields: [requestId], references: [id])
  evidence     FileAsset[]
  @@index([status, createdAt])
  @@index([reportedUserId, status])
}

model Verification {
  id                   String             @id @default(uuid()) @db.Uuid
  workerId             String             @unique @db.Uuid
  status               VerificationStatus @default(PENDING)
  documentObjectKey    String?
  documentContentType  String?
  documentSizeBytes    Int?
  submittedAt          DateTime?
  reviewedBy           String?            @db.Uuid
  reviewedAt           DateTime?
  notes                String?
  worker               WorkerProfile      @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model FileAsset {
  id          String            @id @default(uuid()) @db.Uuid
  objectKey   String            @unique
  contentType String
  sizeBytes   Int
  ownerId     String            @db.Uuid
  requestId   String?           @db.Uuid
  reportId    String?           @db.Uuid
  createdAt   DateTime          @default(now())
  request     ServiceRequest?   @relation(fields: [requestId], references: [id])
  report      Report?           @relation(fields: [reportId], references: [id])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model SavedWorker {
  userId      String        @db.Uuid
  workerId    String        @db.Uuid
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  worker      WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@id([userId, workerId])
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  label       String
  addressLine String
  city        String
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  action    String
  targetType String
  targetId  String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}
